from flask import Flask, request, render_template_string
import subprocess
import os

app = Flask(__name__)

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SEARCH_SCRIPT = os.path.join(SCRIPT_DIR, "search_fails.py")


PAGE = """
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Search Fails</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 50px;
        }

        .container {
            max-width: 800px;
        }

        input {
            width: 500px;
            padding: 10px;
            font-size: 16px;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }

        .result {
            margin-top: 30px;
            padding: 20px;
            background: #f2f2f2;
            border: 1px solid #ccc;
            white-space: pre-wrap;
            font-family: monospace;
        }

        .success {
            border-left: 5px solid green;
        }

        .error {
            border-left: 5px solid red;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Search Fails</h1>

    <form method="POST">

        <label for="folder">Folder name:</label>

        <br><br>

        <input
            id="folder"
            type="text"
            name="folder"
            placeholder="Example: 702615000143_20260720155202"
            required
        >

        <button type="submit">
            Run Search
        </button>

    </form>


    {% if message %}

        <div class="result {{ status }}">
{{ message }}
        </div>

    {% endif %}

</div>

</body>
</html>
"""


@app.route("/", methods=["GET", "POST"])
def index():

    message = ""
    status = ""

    if request.method == "POST":

        folder = request.form.get(
            "folder",
            ""
        ).strip()

        # Ne razreshaem peredavat proizvolnye puti
        if (
            not folder
            or "/" in folder
            or "\\" in folder
            or folder in [".", ".."]
        ):

            message = "Invalid folder name"
            status = "error"

            return render_template_string(
                PAGE,
                message=message,
                status=status
            )

        try:

            result = subprocess.run(
                [
                    "python3",
                    SEARCH_SCRIPT,
                    folder
                ],
                cwd=SCRIPT_DIR,
                capture_output=True,
                text=True,
                timeout=3600
            )

            if result.returncode == 0:

                status = "success"

                message = (
                    "Search completed successfully.\n\n"
                    + result.stdout
                )

            else:

                status = "error"

                message = (
                    "Search failed.\n\n"
                    + result.stdout
                    + "\n"
                    + result.stderr
                )

        except subprocess.TimeoutExpired:

            status = "error"
            message = "Search timeout."

        except Exception as error:

            status = "error"
            message = f"Error: {error}"

    return render_template_string(
        PAGE,
        message=message,
        status=status
    )


if __name__ == "__main__":

    app.run(
        host="0.0.0.0",
        port=5000,
        debug=False
    )